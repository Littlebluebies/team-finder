{
  "name": "team-finder/backend",
  "description": "Team Finder Yii2 JSON API",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "yiisoft/yii2": "~2.0.53",
    "yiisoft/yii2-symfonymailer": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "app\\": ""
    }
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ]
}
